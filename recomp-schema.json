{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeremybris/PlayOut-metadata/blob/main/recomp-schema.json",
  "title": "PlayOut recompilation (recomps/<owner>__<repo>.json)",
  "description": "A recompilation (a native PC port of a console game) someone added in PlayOut's Recompilations browser and the owner approved. GitHub repositories only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "repo", "repoUrl", "game", "systemId"],
  "properties": {
    "id": {
      "description": "github:<owner>/<repo>, lower case: PlayOut's id of the recompilation (validate.mjs checks it against repo).",
      "type": "string",
      "maxLength": 150,
      "pattern": "^github:[a-z0-9][a-z0-9-]{0,38}/[a-z0-9._-]{1,100}$"
    },
    "repo": {
      "description": "<owner>/<repo> as GitHub spells it (its full_name).",
      "type": "string",
      "maxLength": 141,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9._-]{1,100}$"
    },
    "repoUrl": {
      "description": "https://github.com/<repo> (validate.mjs checks it against repo).",
      "type": "string",
      "maxLength": 200,
      "pattern": "^https://github\\.com/[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9._-]{1,100}$"
    },
    "game": {
      "description": "The original game's name (one line, no tabs or other control characters).",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
    },
    "systemId": {
      "description": "PlayOut's system id of the original console (n64, ps2, xbox360, pc, ...) or 'other': one of PlayOut's RECOMP_CONSOLE_IDS (src/main/recomp/consoles.ts; the relay's src/recomp-consoles.ts is the same list).",
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "pattern": "^[a-z0-9]+$",
      "enum": [
        "n64",
        "xbox360",
        "xbox",
        "xboxone",
        "psx",
        "ps2",
        "ps3",
        "ps4",
        "ps5",
        "psp",
        "psvita",
        "gc",
        "wii",
        "wiiu",
        "snes",
        "nes",
        "fds",
        "gba",
        "gb",
        "gbc",
        "nds",
        "n3ds",
        "virtualboy",
        "dreamcast",
        "saturn",
        "genesis",
        "sega32x",
        "segacd",
        "mastersystem",
        "gamegear",
        "switch",
        "switch2",
        "arcade",
        "cps1",
        "cps2",
        "cps3",
        "neogeo",
        "model2",
        "model3",
        "naomi",
        "naomi2",
        "stv",
        "triforce",
        "cdimono1",
        "amiga",
        "amigacd32",
        "c64",
        "apple2",
        "macintosh",
        "atari2600",
        "atari800",
        "atarist",
        "atarilynx",
        "zxspectrum",
        "bbcmicro",
        "msx",
        "pc98",
        "x68000",
        "fmtowns",
        "ngage",
        "j2me",
        "flash",
        "pico8",
        "3do",
        "dos",
        "pc",
        "other"
      ]
    },
    "blurb": {
      "description": "One line about the project (plain text, no tabs or other control characters).",
      "type": "string",
      "maxLength": 500,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "addedAt": {
      "type": "string",
      "maxLength": 64
    },
    "updatedAt": {
      "type": "string",
      "maxLength": 64
    }
  }
}
